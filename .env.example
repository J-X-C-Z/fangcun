# 方寸服务端基础配置
HOST=127.0.0.1
PORT=18443
DATA_DIR=/var/lib/fangcun
TRUST_PROXY=true
COOKIE_SECURE=true

# Outlook / Microsoft Graph 双向同步
MICROSOFT_CLIENT_ID=replace-with-entra-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret-value
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://fangcun.example.org/api/integrations/outlook/callback

# Google Calendar API 双向同步
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_REDIRECT_URI=https://fangcun.example.org/api/integrations/google/callback

# 两个集成共用的服务端令牌加密密钥；部署后不要更换
FANGCUN_INTEGRATION_KEY=replace-with-at-least-32-random-characters

# Voice command write limit per account and source address in 15 minutes
FANGCUN_VOICE_RATE_LIMIT=30
