<template>
  <div class="page {{motionClass}}" @swipe="handleSwipe">
    <scroll class="page-scroll" scroll-y="true" bounces="true">
      <div class="content column">
        <div class="top-bar row"><text class="back" onclick="goBack">‹</text><text class="page-title">优先级</text><text class="clock">19:06</text></div>

        <div class="group column">
          <div class="group-head row"><div class="dot red"></div><text class="group-title">重要 · 紧急</text><text class="group-count">2</text></div>
          <div class="task row" onclick="toggleUrgentOne"><div class="check center {{urgentOneDone ? 'checked' : ''}}"><text class="check-mark">{{urgentOneDone ? '✓' : ''}}</text></div><text class="task-title {{urgentOneDone ? 'done' : ''}}">物理实验报告</text></div>
          <div class="task row"><div class="check"></div><text class="task-title">明天考试复习</text></div>
        </div>

        <div class="group column">
          <div class="group-head row"><div class="dot yellow"></div><text class="group-title">不重要 · 紧急</text><text class="group-count">1</text></div>
          <div class="task row"><div class="check"></div><text class="task-title">跑步 30 分钟</text></div>
        </div>

        <div class="group column">
          <div class="group-head row"><div class="dot blue"></div><text class="group-title">重要 · 不紧急</text><text class="group-count">1</text></div>
          <div class="task row"><div class="check"></div><text class="task-title">C++ 作业</text></div>
        </div>

        <div class="group column">
          <div class="group-head row"><div class="dot green"></div><text class="group-title">不重要 · 不紧急</text><text class="group-count">1</text></div>
          <div class="task row"><div class="check"></div><text class="task-title">BBC 英语听力</text></div>
        </div>
        <text class="hint">点击任务即可完成 · 右滑返回</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import haptic from "../../common/haptic"
export default {
  private: { urgentOneDone: false, motionClass: "enter-right" },
  toggleUrgentOne() { haptic.medium(); this.urgentOneDone = !this.urgentOneDone },
  goBack() { haptic.light(); router.back() },
  handleSwipe(e) {
    if (e.direction === "right") {
      haptic.light()
      this.motionClass = "exit-right"
      setTimeout(() => router.back(), 170)
    }
  }
}
</script>

<style>
text { color: #ffffff; }
.row { flex-direction: row; }
.column { flex-direction: column; }
.center { justify-content: center; align-items: center; }
.page { width: 100%; height: 100%; padding: 18px; border-radius: 36px; background-color: #000000; }
.enter-right { animation-name: enterRight; animation-duration: 180ms; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
.exit-right { animation-name: exitRight; animation-duration: 180ms; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
.page-scroll { width: 100%; height: 100%; border-radius: 24px; }
.content { width: 300px; padding-bottom: 20px; }
.top-bar { width: 300px; height: 56px; align-items: center; }
.back { width: 34px; font-size: 40px; color: #ffffff; }
.page-title { width: 192px; font-size: 27px; font-weight: 700; color: #ffffff; }
.clock { width: 74px; font-size: 21px; text-align: right; color: #e3e6ec; }
.group { width: 300px; margin-bottom: 14px; padding: 16px; border-radius: 18px; background-color: #191d22; }
.group-head { width: 268px; height: 40px; align-items: center; }
.dot { width: 12px; height: 12px; margin-right: 10px; border-radius: 6px; }
.red { background-color: #ff7568; }
.yellow { background-color: #f3c344; }
.blue { background-color: #4e98ff; }
.green { background-color: #43d58d; }
.group-title { width: 210px; font-size: 21px; font-weight: 700; color: #eef1f7; }
.group-count { width: 30px; font-size: 19px; text-align: right; color: #8f98a8; }
.task { width: 268px; height: 76px; align-items: center; }
.check { width: 30px; height: 30px; margin-right: 12px; border: 2px solid #8b96a8; border-radius: 15px; }
.checked { border-color: #36d47f; background-color: #36d47f; }
.check-mark { font-size: 18px; color: #ffffff; }
.task-title { width: 226px; font-size: 21px; color: #ffffff; }
.done { color: #777f8b; text-decoration: line-through; }
.hint { width: 300px; margin-top: 10px; font-size: 16px; text-align: center; color: #7a8391; }
@keyframes enterRight { 0% { transform: translateX(32px); opacity: 0.2; } 100% { transform: translateX(0px); opacity: 1; } }
@keyframes exitRight { 0% { transform: translateX(0px); opacity: 1; } 100% { transform: translateX(32px); opacity: 0.2; } }
</style>
